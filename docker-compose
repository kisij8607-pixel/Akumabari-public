services:
  cowrie:
    image: cowrie/cowrie:latest
    container_name: cowrie
    restart: unless-stopped
    ports:
      - "${COWRIE_SSH_HOST_PORT:-22222}:2222"
      - "${COWRIE_TELNET_HOST_PORT:-2223}:2223"
    volumes:
      - ./cowrie/etc:${COWRIE_ETC}
      - /home/kisij/akumabarai/bin/cowrie:${COWRIE_BIN}
      - /home/kisij/akumabarai/logs/cowrie:${COWRIE_LOG}
      - cowrie_tty:${COWRIE_TTY}
    environment:
      - COWRIE_HOSTNAME=${COWRIE_HOSTNAME:-production-db-01}
      - COWRIE_SSH_VERSION=${COWRIE_SSH_VERSION:-SSH-2.0-OpenSSH_8.2p1}
    networks:
      - akumabarai_net
    security_opt:
      - no-new-privileges:true
    healthcheck:
      disable: true
    logging:
      driver: "json-file"
      options:
        max-size: "10m"
        max-file: "3"

  dionaea:
    image: dtagdevsec/dionaea:24.04.1
    container_name: dionaea
    init: true
    restart: unless-stopped
    ports:
      - "${DIONAEA_FTP_HOST_PORT:-21}:21"
      - "${DIONAEA_WINS_HOST_PORT:-42}:42"
      - "${DIONAEA_TFTP_HOST_PORT:-69}:69/udp"
      - "${DIONAEA_HTTP_HOST_PORT:-80}:80"
      - "${DIONAEA_MSRPC_HOST_PORT:-135}:135"
      - "${DIONAEA_HTTPS_HOST_PORT:-443}:443"
      - "${DIONAEA_SMB_HOST_PORT:-445}:445"
      - "${DIONAEA_MSSQL_HOST_PORT:-1433}:1433"
      - "${DIONAEA_MYSQL_HOST_PORT:-3306}:3306"
    volumes:
      - ./dionaea/etc/dionaea:${DIONAEA_ETC}
      - /home/kisij/akumabarai/bin/dionaea:${DIONAEA_BIN}
      - /home/kisij/akumabarai/logs/dionaea:${DIONAEA_LOG}
      - /home/kisij/akumabarai/bistreams:${DIONAEA_BTSTR}
    networks:
      - akumabarai_net
    cap_add:
      - NET_BIND_SERVICE
      - NET_ADMIN
    healthcheck:
      disable: true
    logging:
      driver: "json-file"
      options:
        max-size: "10m"
        max-file: "3"

networks:
  akumabarai_net:
    driver: bridge

volumes:
  cowrie_tty:
